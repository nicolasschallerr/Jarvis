# Plantilla de variables de entorno de Jarvis. NO poner valores reales acá.
#
# Uso local: copiar este archivo como .env.local y completar los valores.
#   Copy-Item .env.example .env.local
# Producción: cargar las mismas variables en Vercel (Settings > Environment Variables).
#
# Regla: las variables con prefijo NEXT_PUBLIC_ se incluyen en el código que llega al navegador
# y son públicas. Todo secreto va SIN ese prefijo.

# --- Supabase (base de Jarvis) ---
# Dashboard de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable o anon, según muestre el dashboard). Segura para el navegador porque
# las tablas se protegen con RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETO. Saltea RLS. Solo en el servidor (webhooks, jobs). Nunca en el navegador ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Fase 6 en adelante) ---
# SECRETO. Console > API keys, creada dentro del workspace jarvis-dev.
ANTHROPIC_API_KEY=

# --- Meta / WhatsApp Cloud API (Fase 3) ---
# SECRETOS. Se completan cuando armemos el webhook.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Token permanente de un usuario del sistema (no el token temporal del panel).
WHATSAPP_ACCESS_TOKEN=
# Versión de la Graph API de Meta (opcional, por defecto v23.0). Plantillas de WhatsApp, ADR-030.
META_GRAPH_VERSION=

# --- Trabajador (Fase 3) ---
# SECRETO. Lo usa pg_cron para invocar /api/worker/*. Generar con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WORKER_SECRET=

# --- Telegram (canal de desarrollo) ---
# SECRETO. Token que entrega @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# SECRETO. Lo inventamos nosotros (letras, números, guion y guion bajo). Telegram lo devuelve en
# cada pedido para probar que viene de él. Generar con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
